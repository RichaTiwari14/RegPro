# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.
# Web3Forms access key (https://web3forms.com) — enquiries are emailed to the address you register there.
VITE_WEB3FORMS_KEY=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_ID=
# Meta (Facebook) Pixel ID
VITE_META_PIXEL_ID=
