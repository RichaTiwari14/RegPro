# Copy to .env.local (or set in Vercel → Project → Settings → Environment Variables).
# Everything prefixed VITE_ is bundled into public JavaScript — never put secret keys here.

# Base URL of the backend that receives enquiries (POST {VITE_API_BASE_URL}/api/enquiries/).
# Leave empty and the form will say online enquiries are not connected and point to WhatsApp / call.
VITE_API_BASE_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = analytics disabled.
VITE_GA_ID=

# Meta Pixel ID. Empty = pixel disabled.
VITE_META_PIXEL_ID=

# Only for scripts/generate-images.mjs (run locally / in CI). Never prefix with VITE_.
# OPENAI_API_KEY=
